{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-portfolio:CopyMandate:1",
  "title": "CopyMandate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mandate_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_id": {
      "type": "string",
      "minLength": 1
    },
    "account_identity": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_version_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "risk_policy_hash": {
      "type": "string",
      "minLength": 1
    },
    "join_mode": {
      "enum": [
        "NEW_ENTRIES_ONLY",
        "EXPLICIT_SYNC_APPROVED"
      ]
    },
    "termination_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "agreement_hash": {
      "type": "string",
      "minLength": 1
    },
    "consented_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "DRAFT",
        "PENDING_PLATFORM",
        "ACTIVE",
        "SUSPEND_NEW",
        "REVOKING",
        "REVOKED",
        "HANDOFF",
        "CLOSED"
      ]
    }
  },
  "required": [
    "mandate_id",
    "tenant_id",
    "customer_id",
    "account_identity",
    "environment",
    "portfolio_version_ids",
    "assets",
    "channel",
    "risk_policy_hash",
    "join_mode",
    "termination_policy_id",
    "agreement_hash",
    "consented_at",
    "expires_at",
    "state"
  ]
}
