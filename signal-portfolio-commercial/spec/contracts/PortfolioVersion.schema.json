{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-portfolio:PortfolioVersion:1",
  "title": "PortfolioVersion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sleeve_id",
          "weight_bps",
          "policy_hash",
          "rights_grant_ids"
        ],
        "properties": {
          "sleeve_id": {
            "type": "string",
            "minLength": 1
          },
          "weight_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "policy_hash": {
            "type": "string",
            "minLength": 1
          },
          "rights_grant_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "cash_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "risk_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "universe_hash": {
      "type": "string",
      "minLength": 1
    },
    "research_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "data_manifest_hash": {
      "type": "string",
      "minLength": 1
    },
    "report_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "RESEARCH",
        "SHADOW",
        "APPROVED",
        "RELEASED",
        "SUSPENDED",
        "RETIRED"
      ]
    },
    "release_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "portfolio_id",
    "version_id",
    "parent_version_id",
    "components",
    "cash_bps",
    "risk_policy_id",
    "universe_hash",
    "research_cutoff",
    "data_manifest_hash",
    "report_ids",
    "status",
    "release_id"
  ]
}
