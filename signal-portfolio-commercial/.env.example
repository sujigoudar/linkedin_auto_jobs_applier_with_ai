# Copy to .env and fill in for a real deployment. Never commit the real
# .env file. Every value here (see app/config.py's own docstrings for the
# full "why" on each) defaults to an obviously-fake LOCAL_SIM placeholder
# when unset -- safe for local/paper use, but every one of them MUST be
# replaced with a real, randomly-generated value before this app is ever
# pointed at real money or a real customer.
#
# This file did not exist anywhere in this build until this pass found the
# gap: signal-copier/.env.example documents every credential-shaped
# variable that app reads; this one, historically, documented none.

# A real Postgres DSN -- see docker-compose.yml at the repo root for a
# working local/paper example (a dedicated, restricted `commercial` role,
# never the Postgres superuser).
COMMERCIAL_DATABASE_URL=postgresql+psycopg://commercial:CHANGE_ME@localhost:5432/commercial

# A SEPARATE, more-privileged Postgres DSN used ONLY by deploy/entrypoint-
# commercial.sh's own migration + bootstrap steps (`alembic upgrade head`,
# then ops/bootstrap.py) -- never used by the running app itself, which
# only ever connects as COMMERCIAL_DATABASE_URL's own restricted role. A
# real deployment should use a dedicated migrator role with schema-owner
# rights (CREATE/ALTER/GRANT), not the Postgres superuser docker-
# compose.yml's own local/paper example uses for convenience.
COMMERCIAL_MIGRATOR_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/commercial

# Read directly by ops/bootstrap.py (never passed as a CLI argument --
# see that script's own module docstring on why) to set the runtime
# `commercial` role's real password via ALTER ROLE, matching
# COMMERCIAL_DATABASE_URL's own credentials above. Neither role has a
# password by default -- a fresh deployment's own bootstrap step will
# fail outright without this set.
COMMERCIAL_RUNTIME_ROLE_PASSWORD=CHANGE_ME
# Same, for the restricted `relay_role` connection RELAY_DATABASE_URL
# below uses -- a SEPARATE password from COMMERCIAL_RUNTIME_ROLE_PASSWORD
# above, matching RELAY_DATABASE_URL's own credentials.
RELAY_ROLE_PASSWORD=CHANGE_ME

# LOCAL_SIM | INTEGRATION_ISOLATED | PLATFORM_DEMO | PRIVATE_SHADOW |
# COMMERCIAL_LIVE -- see spec/docs/02_architecture_and_tenancy.md's own
# "Environments" section. Never set this to COMMERCIAL_LIVE until every
# other item in this file is a real, non-placeholder value AND real
# broker/vendor accounts actually back whatever this environment claims.
ENVIRONMENT=LOCAL_SIM

# Signing secret for this app's OWN local/test JWT issuer
# (app/services/auth.py) -- generate a real random value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT, read app/config.py's own docstring on this: a real production
# deployment's actual customer/owner identity is meant to come from a real
# external auth provider (Supabase Auth is named in this build's own
# design docs) -- that integration does not exist anywhere in this
# codebase yet. This local issuer (and signal-portfolio-commercial/ops/
# bootstrap.py, which uses it to mint an owner's first session token) is
# real and functional, but it is explicitly a stand-in, not the intended
# real-deployment auth path. Treat "who can log in as owner/customer" as
# an open item, not solved by setting this variable.
LOCAL_JWT_SECRET=CHANGE_ME

# The restricted relay's own shared signing secret (app/services/
# relay_auth.py here, app/relay_worker.py on signal-copier's own side) --
# BOTH sides must be set to the identical value. Generate with the same
# command as LOCAL_JWT_SECRET above; rotate independently of every other
# secret in this file.
RELAY_SIGNING_SECRET=CHANGE_ME

# Postgres DSN for the restricted `relay_role` connection (app/api/
# relay_routes.py) -- deliberately a DIFFERENT role than
# COMMERCIAL_DATABASE_URL's own, with narrower privileges (see app/db.py's
# `_apply_relay_role_access`).
RELAY_DATABASE_URL=postgresql+psycopg://relay_role:CHANGE_ME@localhost:5432/commercial

# The Stripe webhook signing secret app/services/stripe_webhook.py
# verifies incoming events against -- the real value Stripe's own
# dashboard issues once a real Stripe account exists (CARD-4 in this
# build's own design docs: not yet obtained anywhere in this codebase).
# Never a real `whsec_...` value until that real account exists.
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
