{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PU01ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "PU-01"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "product",
          "asset_scope",
          "holding_horizon",
          "performance_origin",
          "availability"
        ],
        "properties": {
          "product": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Product; server formats semantics as typed value, not prebuilt HTML."
          },
          "asset_scope": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Asset scope; server formats semantics as typed value, not prebuilt HTML."
          },
          "holding_horizon": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Holding horizon; server formats semantics as typed value, not prebuilt HTML."
          },
          "performance_origin": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Performance origin; server formats semantics as typed value, not prebuilt HTML."
          },
          "availability": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Availability; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
