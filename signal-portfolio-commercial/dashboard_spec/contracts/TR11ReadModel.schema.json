{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TR11ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "TR-11"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "rule",
          "provider_analyst",
          "assets",
          "destinations",
          "effective_state",
          "conflict"
        ],
        "properties": {
          "rule": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Rule; server formats semantics as typed value, not prebuilt HTML."
          },
          "provider_analyst": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Provider/analyst; server formats semantics as typed value, not prebuilt HTML."
          },
          "assets": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Assets; server formats semantics as typed value, not prebuilt HTML."
          },
          "destinations": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Destinations; server formats semantics as typed value, not prebuilt HTML."
          },
          "effective_state": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Effective state; server formats semantics as typed value, not prebuilt HTML."
          },
          "conflict": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Conflict; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
