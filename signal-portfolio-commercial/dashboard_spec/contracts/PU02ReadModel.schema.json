{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PU02ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "PU-02"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "portfolio",
          "version",
          "assets",
          "strategy_horizon",
          "net_return",
          "maximum_drawdown",
          "history_window",
          "origin",
          "service_modes",
          "price_basis"
        ],
        "properties": {
          "portfolio": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Portfolio; server formats semantics as typed value, not prebuilt HTML."
          },
          "version": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Version; server formats semantics as typed value, not prebuilt HTML."
          },
          "assets": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Assets; server formats semantics as typed value, not prebuilt HTML."
          },
          "strategy_horizon": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Strategy horizon; server formats semantics as typed value, not prebuilt HTML."
          },
          "net_return": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Net return; server formats semantics as typed value, not prebuilt HTML."
          },
          "maximum_drawdown": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Maximum drawdown; server formats semantics as typed value, not prebuilt HTML."
          },
          "history_window": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "History window; server formats semantics as typed value, not prebuilt HTML."
          },
          "origin": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Origin; server formats semantics as typed value, not prebuilt HTML."
          },
          "service_modes": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Service modes; server formats semantics as typed value, not prebuilt HTML."
          },
          "price_basis": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Price basis; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
