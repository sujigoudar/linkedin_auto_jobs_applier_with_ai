{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CU15ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "CU-15"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "program",
          "broker_status",
          "units_or_allocation_method",
          "nav_date",
          "fees",
          "cashflow_request_state"
        ],
        "properties": {
          "program": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Program; server formats semantics as typed value, not prebuilt HTML."
          },
          "broker_status": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Broker status; server formats semantics as typed value, not prebuilt HTML."
          },
          "units_or_allocation_method": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Units or allocation method; server formats semantics as typed value, not prebuilt HTML."
          },
          "nav_date": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "NAV date; server formats semantics as typed value, not prebuilt HTML."
          },
          "fees": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Fees; server formats semantics as typed value, not prebuilt HTML."
          },
          "cashflow_request_state": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Cashflow request state; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
