{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TR09ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "TR-09"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "source",
          "transport",
          "channel_product",
          "analyst_scope",
          "parser",
          "cursor",
          "lag",
          "status"
        ],
        "properties": {
          "source": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Source; server formats semantics as typed value, not prebuilt HTML."
          },
          "transport": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Transport; server formats semantics as typed value, not prebuilt HTML."
          },
          "channel_product": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Channel/product; server formats semantics as typed value, not prebuilt HTML."
          },
          "analyst_scope": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Analyst scope; server formats semantics as typed value, not prebuilt HTML."
          },
          "parser": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Parser; server formats semantics as typed value, not prebuilt HTML."
          },
          "cursor": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Cursor; server formats semantics as typed value, not prebuilt HTML."
          },
          "lag": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Lag; server formats semantics as typed value, not prebuilt HTML."
          },
          "status": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Status; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
