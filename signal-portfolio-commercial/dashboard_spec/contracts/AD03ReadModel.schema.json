{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AD03ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "AD-03"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "sleeve",
          "provider_analyst",
          "strategy",
          "parser_policy",
          "history_window",
          "rights",
          "coverage",
          "capacity"
        ],
        "properties": {
          "sleeve": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Sleeve; server formats semantics as typed value, not prebuilt HTML."
          },
          "provider_analyst": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Provider/analyst; server formats semantics as typed value, not prebuilt HTML."
          },
          "strategy": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Strategy; server formats semantics as typed value, not prebuilt HTML."
          },
          "parser_policy": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Parser/policy; server formats semantics as typed value, not prebuilt HTML."
          },
          "history_window": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "History window; server formats semantics as typed value, not prebuilt HTML."
          },
          "rights": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Rights; server formats semantics as typed value, not prebuilt HTML."
          },
          "coverage": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Coverage; server formats semantics as typed value, not prebuilt HTML."
          },
          "capacity": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Capacity; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
