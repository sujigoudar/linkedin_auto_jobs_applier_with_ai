{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AD15ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "AD-15"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "account",
          "allocation_basis",
          "nav_generation",
          "units",
          "cashflow_cutoff",
          "fee",
          "discrepancy"
        ],
        "properties": {
          "account": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Account; server formats semantics as typed value, not prebuilt HTML."
          },
          "allocation_basis": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Allocation basis; server formats semantics as typed value, not prebuilt HTML."
          },
          "nav_generation": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "NAV generation; server formats semantics as typed value, not prebuilt HTML."
          },
          "units": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Units; server formats semantics as typed value, not prebuilt HTML."
          },
          "cashflow_cutoff": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Cashflow cutoff; server formats semantics as typed value, not prebuilt HTML."
          },
          "fee": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Fee; server formats semantics as typed value, not prebuilt HTML."
          },
          "discrepancy": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Discrepancy; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
