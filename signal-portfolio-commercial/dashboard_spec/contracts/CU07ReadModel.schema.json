{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CU07ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "CU-07"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "connection",
          "platform",
          "environment",
          "masked_account",
          "scope",
          "readback_freshness",
          "mandates",
          "state"
        ],
        "properties": {
          "connection": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Connection; server formats semantics as typed value, not prebuilt HTML."
          },
          "platform": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Platform; server formats semantics as typed value, not prebuilt HTML."
          },
          "environment": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Environment; server formats semantics as typed value, not prebuilt HTML."
          },
          "masked_account": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Masked account; server formats semantics as typed value, not prebuilt HTML."
          },
          "scope": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Scope; server formats semantics as typed value, not prebuilt HTML."
          },
          "readback_freshness": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Readback freshness; server formats semantics as typed value, not prebuilt HTML."
          },
          "mandates": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Mandates; server formats semantics as typed value, not prebuilt HTML."
          },
          "state": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "State; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
