{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TR03ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "TR-03"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "family_order",
          "purpose",
          "requested",
          "cumulative_filled",
          "remaining_possible",
          "status",
          "coverage_evidence"
        ],
        "properties": {
          "family_order": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Family/order; server formats semantics as typed value, not prebuilt HTML."
          },
          "purpose": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Purpose; server formats semantics as typed value, not prebuilt HTML."
          },
          "requested": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Requested; server formats semantics as typed value, not prebuilt HTML."
          },
          "cumulative_filled": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Cumulative filled; server formats semantics as typed value, not prebuilt HTML."
          },
          "remaining_possible": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Remaining possible; server formats semantics as typed value, not prebuilt HTML."
          },
          "status": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Status; server formats semantics as typed value, not prebuilt HTML."
          },
          "coverage_evidence": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Coverage evidence; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
