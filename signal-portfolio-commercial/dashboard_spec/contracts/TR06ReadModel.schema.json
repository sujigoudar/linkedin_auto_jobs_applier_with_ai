{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TR06ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "TR-06"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "intent",
          "account",
          "instrument",
          "purpose",
          "broker_id",
          "acknowledged",
          "filled",
          "remaining",
          "outcome"
        ],
        "properties": {
          "intent": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Intent; server formats semantics as typed value, not prebuilt HTML."
          },
          "account": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Account; server formats semantics as typed value, not prebuilt HTML."
          },
          "instrument": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Instrument; server formats semantics as typed value, not prebuilt HTML."
          },
          "purpose": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Purpose; server formats semantics as typed value, not prebuilt HTML."
          },
          "broker_id": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Broker ID; server formats semantics as typed value, not prebuilt HTML."
          },
          "acknowledged": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Acknowledged; server formats semantics as typed value, not prebuilt HTML."
          },
          "filled": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Filled; server formats semantics as typed value, not prebuilt HTML."
          },
          "remaining": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Remaining; server formats semantics as typed value, not prebuilt HTML."
          },
          "outcome": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Outcome; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
