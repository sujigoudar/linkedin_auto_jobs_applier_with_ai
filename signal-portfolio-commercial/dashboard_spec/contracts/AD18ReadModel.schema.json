{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AD18ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "AD-18"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "event",
          "actor",
          "tenant_scope",
          "action",
          "before_after_hash",
          "outcome",
          "correlation",
          "time"
        ],
        "properties": {
          "event": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Event; server formats semantics as typed value, not prebuilt HTML."
          },
          "actor": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Actor; server formats semantics as typed value, not prebuilt HTML."
          },
          "tenant_scope": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Tenant/scope; server formats semantics as typed value, not prebuilt HTML."
          },
          "action": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Action; server formats semantics as typed value, not prebuilt HTML."
          },
          "before_after_hash": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Before/after hash; server formats semantics as typed value, not prebuilt HTML."
          },
          "outcome": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Outcome; server formats semantics as typed value, not prebuilt HTML."
          },
          "correlation": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Correlation; server formats semantics as typed value, not prebuilt HTML."
          },
          "time": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Time; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
