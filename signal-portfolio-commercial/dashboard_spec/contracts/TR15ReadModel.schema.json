{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TR15ReadModel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "state",
    "snapshot_id",
    "schema_version",
    "generated_at",
    "origin_label",
    "summary",
    "rows",
    "metrics",
    "capabilities",
    "next_cursor",
    "panels"
  ],
  "properties": {
    "screen_id": {
      "const": "TR-15"
    },
    "schema_version": {
      "const": "ui-v2"
    },
    "state": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "denied",
        "stale",
        "partial",
        "timeout",
        "error",
        "unsupported",
        "conflict",
        "session_expired",
        "maintenance"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "run",
          "source_versions",
          "period",
          "coverage",
          "recipe",
          "state",
          "net_result",
          "uncertainty"
        ],
        "properties": {
          "run": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Run; server formats semantics as typed value, not prebuilt HTML."
          },
          "source_versions": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Source versions; server formats semantics as typed value, not prebuilt HTML."
          },
          "period": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Period; server formats semantics as typed value, not prebuilt HTML."
          },
          "coverage": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Coverage; server formats semantics as typed value, not prebuilt HTML."
          },
          "recipe": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Recipe; server formats semantics as typed value, not prebuilt HTML."
          },
          "state": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "State; server formats semantics as typed value, not prebuilt HTML."
          },
          "net_result": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Net result; server formats semantics as typed value, not prebuilt HTML."
          },
          "uncertainty": {
            "$ref": "ui-contracts.schema.json#/$defs/Cell",
            "description": "Uncertainty; server formats semantics as typed value, not prebuilt HTML."
          },
          "row_id": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Metric"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Capability"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope_label": {
      "type": "string"
    },
    "object_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "ui-contracts.schema.json#/$defs/Panel"
      }
    }
  }
}
