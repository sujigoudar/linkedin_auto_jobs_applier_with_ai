# Copy to wrangler.toml, fill in your account/zone details, then:
#   wrangler kv:namespace create HEARTBEAT_KV   # get the id below
#   wrangler secret put ALERT_WEBHOOK_URL
#   wrangler deploy
# None of this has been run -- no account_id/KV namespace exists yet.

name = "signal-copier-heartbeat"
main = "worker.js"
compatibility_date = "2024-01-01"

# Once-a-minute matches the recovery-objective doc's "detect sustained
# progress loss within three external one-minute checks" -- adjust only
# alongside FAILURE_THRESHOLD below, and re-check Workers Free's
# 100,000 requests/day allowance (1,440 cron triggers/day is comfortably
# under it on its own).
[triggers]
crons = ["* * * * *"]

[vars]
ACTIVE_HEALTH_URL = "https://REPLACE-WITH-ACTIVE-SITE/health"
FAILURE_THRESHOLD = "3"

[[kv_namespaces]]
binding = "HEARTBEAT_KV"
id = "REPLACE_WITH_REAL_KV_NAMESPACE_ID"

# ALERT_WEBHOOK_URL is a secret, not a var -- `wrangler secret put ALERT_WEBHOOK_URL`
