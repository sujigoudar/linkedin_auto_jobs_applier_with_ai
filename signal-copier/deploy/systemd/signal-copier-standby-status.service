[Unit]
Description=Signal Copier - standby (STANDBY_MODE=true, read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signal-copier
Group=signal-copier
WorkingDirectory=/opt/signal-copier/src/signal-copier
EnvironmentFile=/etc/signal-copier/standby.env
Environment=STANDBY_MODE=true
# No OWNER_PASSWORD/SESSION_SECRET/broker credentials in standby.env --
# absence, not merely STANDBY_MODE, is the second independent reason this
# process can never accept a financial command (app/auth.py's RequireOwner
# already fails closed with 503 when those are unset).
ExecStart=/opt/signal-copier/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/signal-copier
ProtectHome=true

[Install]
WantedBy=multi-user.target
