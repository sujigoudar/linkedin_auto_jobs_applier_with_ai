# Copy to .env and fill in. Never commit the real .env file.

# Config file locations (defaults shown; override if you don't want to copy
# the .example files)
ROUTING_CONFIG_PATH=config/routing.yaml
ACCOUNTS_CONFIG_PATH=config/accounts.yaml
DATABASE_PATH=signal_copier.db

LOG_LEVEL=INFO

# Shared secret required in the X-Webhook-Secret header on every
# POST /webhook/{source} request. Leave blank only for local testing --
# blank means that route is DISABLED (503), never silently open.
WEBHOOK_SHARED_SECRET=

# Owner authentication (see README's "Owner authentication" section and
# app/auth.py) -- gates every account/routing/provider/position/close/
# flatten/backtest/signals/orders endpoint. Set exactly one of
# OWNER_PASSWORD/OWNER_PASSWORD_HASH (never both) plus SESSION_SECRET, or
# every one of those endpoints fails closed (503). Generate SESSION_SECRET
# with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# OWNER_PASSWORD_HASH (recommended, C05) is an argon2id hash, so the
# configured value itself isn't a usable credential even if it leaks:
#   python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('<your password>'))"
OWNER_PASSWORD=
OWNER_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200       # 12h

# Optional read-only market/economic context lookups (see README's
# "Market/economic context" section and app/context/). Neither is used
# anywhere in the order-management/protective-stop path.
SEC_EDGAR_USER_AGENT=           # e.g. "YourCompany admin@example.com" -- required by SEC's fair-access policy
FRED_API_KEY=                   # free key: https://fredaccount.stlouisfed.org/apikeys

# --- Broker credentials, one set per account_id defined in accounts.yaml ---
# CCXT (crypto exchange) accounts:
CCXT_BINANCE_SUB1_API_KEY=
CCXT_BINANCE_SUB1_API_SECRET=
CCXT_BINANCE_SUB2_API_KEY=
CCXT_BINANCE_SUB2_API_SECRET=

# SignalStack accounts: the per-account webhook URL from the SignalStack
# dashboard ("Create Webhook" on the connected broker/exchange account).
# SignalStack itself fans this out to the actual broker/exchange.
SIGNALSTACK_IBKR_MAIN_WEBHOOK_URL=
SIGNALSTACK_BYBIT_MAIN_WEBHOOK_URL=

# Alpaca accounts (BASE_URL defaults to the paper endpoint if unset):
ALPACA_MAIN_API_KEY=
ALPACA_MAIN_API_SECRET=
ALPACA_MAIN_BASE_URL=https://paper-api.alpaca.markets

# MT5 accounts (same-host terminal only, one terminal instance per account):
MT5_MAIN_LOGIN=
MT5_MAIN_PASSWORD=
MT5_MAIN_SERVER=

# IBKR: no per-account env vars here — connection host/port/client_id are
# passed when constructing IBKRBroker() in app/main.py (one Gateway/TWS
# process per account).

# MT4/MT5 via MetaApi (github.com/metaapi/metaapi-python-sdk), no local
# terminal needed — recommended over the same-host MT5_* vars above unless
# you specifically want to avoid the cloud dependency:
MT4_MT5_METAAPI_TOKEN=
MT4_MT5_METAAPI_MAIN_ID=          # this account's MetaApi account id
MT4_MT5_METAAPI_SOURCE_ACCOUNT_ID=  # MetaApi account id to copy trades FROM (source, not a destination)

# NinjaTrader accounts: the local URL of that account's TradeRouter
# WebhookOrderStrategy.cs instance (github.com/roydufek/traderouter) —
# see app/brokers/ninjatrader.py for setup:
NT8_MAIN_URL=http://127.0.0.1:7091/webhook/

# Rithmic (github.com/rundef/async_rithmic) — licensed credentials from
# your broker; shared login used for both the source and every Rithmic
# destination account:
RITHMIC_USER=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM_NAME=
RITHMIC_GATEWAY_URL=              # e.g. rituz00100.rithmic.com:443 (test gateway)
RITHMIC_SOURCE_ACCOUNT_ID=        # optional: only copy fills from this Rithmic account
# Per Rithmic destination account (account_id as used in accounts.yaml):
RITHMIC_MAIN_RITHMIC_ACCOUNT_ID=  # Rithmic's own account id, from client.list_accounts()
RITHMIC_MAIN_EXCHANGE=            # e.g. CME

# --- Pull-based sources: each only starts if ALL of its vars below are set ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

TWITTER_BEARER_TOKEN=
TWITTER_RULES=                 # comma-separated, e.g. "from:SomeTrader,from:AnotherTrader"

# --- SMS source (push-based via /sms/twilio route) ---
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=            # the exact public URL Twilio POSTs to, e.g. https://yourhost/sms/twilio
TWILIO_ALLOWED_FROM_NUMBERS=   # comma-separated E.164 numbers authorized to send trading SMS, e.g. "+15551234567" -- required, a valid signature alone does not authorize the sender

# --- WhatsApp source (push-based via /whatsapp/webhook route) ---
# Official Meta WhatsApp Business Cloud API -- see app/sources/whatsapp.py's
# docstring for full setup. Deliberately NOT an unofficial WhatsApp Web
# automation library (whatsapp-web.js, Baileys, OpenWA, etc.): those violate
# WhatsApp's Terms of Service and risk the number being banned.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=          # your own chosen value, used once for Meta's GET handshake when the webhook is first configured
WHATSAPP_ALLOWED_FROM_NUMBERS=  # comma-separated numbers with NO leading '+' (WhatsApp's own wa_id format), e.g. "15551234567" -- required, a valid signature alone does not authorize the sender

FORCE_SECURE_COOKIES=      # set true if behind a TLS-terminating reverse proxy (nginx/Caddy) -- see SEC-05
