# Copy to .env and fill in. Never commit the real .env file.

# Config file locations (defaults shown; override if you don't want to copy
# the .example files)
ROUTING_CONFIG_PATH=config/routing.yaml
ACCOUNTS_CONFIG_PATH=config/accounts.yaml
DATABASE_PATH=signal_copier.db

LOG_LEVEL=INFO

# Shared secret required in the X-Webhook-Secret header on every
# POST /webhook/{source} request. Leave blank only for local testing --
# blank means that route is DISABLED (503), never silently open.
WEBHOOK_SHARED_SECRET=

# Owner authentication (see README's "Owner authentication" section and
# app/auth.py) -- gates every account/routing/provider/position/close/
# flatten/backtest/signals/orders endpoint. Set exactly one of
# OWNER_PASSWORD/OWNER_PASSWORD_HASH (never both) plus SESSION_SECRET, or
# every one of those endpoints fails closed (503). Generate SESSION_SECRET
# with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# OWNER_PASSWORD_HASH (recommended, C05) is an argon2id hash, so the
# configured value itself isn't a usable credential even if it leaks:
#   python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('<your password>'))"
OWNER_PASSWORD=
OWNER_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200       # 12h

# The restricted relay to signal-portfolio-commercial (INTEGRATION_DECISION.md
# S4.3) -- runs IN-PROCESS as part of THIS app's own startup (app/
# relay_scheduler.py, started from app/main.py's own `lifespan` handler),
# never a separate process/container. RELAY_INGRESS_URL is the one fixed
# destination it's ever allowed to POST to -- leave blank to disable the
# relay entirely (a blank URL is a loud RelayNotConfiguredError on its
# first poll, logged, never a silent no-op forwarder). RELAY_SIGNING_SECRET
# must match the SAME value signal-portfolio-commercial's own config.py
# reads (both default to the identical LOCAL_SIM literal, safe for local/
# paper use only) -- app/relay_worker.py's own `sign_relay_payload` signs
# every batch with it, and the commercial side's app/services/relay_auth.py
# verifies against it.
RELAY_INGRESS_URL=
RELAY_SIGNING_SECRET=LOCAL_SIM-not-a-real-relay-secret-change-if-ever-deployed
RELAY_POLL_INTERVAL_SECONDS=1.0
RELAY_BATCH_SIZE=100
# Carried onto every exported event's own EventEnvelope -- see
# signal_platform_contracts.envelope's own EvidenceClass/Environment for
# every allowed value. Never set RELAY_EVIDENCE_CLASS to anything claiming
# real/live money before real broker credentials and real observed fills
# actually exist -- an event's own evidence class is a truth claim about
# where its numbers came from, not a display label.
RELAY_PRODUCER_ID=signal-copier-local
RELAY_EVIDENCE_CLASS=INTERNAL_PAPER
RELAY_ENVIRONMENT=LOCAL_SIM

# Optional read-only market/economic context lookups (see README's
# "Market/economic context" section and app/context/). Neither is used
# anywhere in the order-management/protective-stop path.
SEC_EDGAR_USER_AGENT=           # e.g. "YourCompany admin@example.com" -- required by SEC's fair-access policy
FRED_API_KEY=                   # free key: https://fredaccount.stlouisfed.org/apikeys

# --- Broker credentials, one set per account_id defined in accounts.yaml ---
# CCXT (crypto exchange) accounts:
CCXT_BINANCE_SUB1_API_KEY=
CCXT_BINANCE_SUB1_API_SECRET=
CCXT_BINANCE_SUB2_API_KEY=
CCXT_BINANCE_SUB2_API_SECRET=

# SignalStack accounts: the per-account webhook URL from the SignalStack
# dashboard ("Create Webhook" on the connected broker/exchange account).
# SignalStack itself fans this out to the actual broker/exchange.
SIGNALSTACK_IBKR_MAIN_WEBHOOK_URL=
SIGNALSTACK_BYBIT_MAIN_WEBHOOK_URL=

# Alpaca accounts (BASE_URL defaults to the paper endpoint if unset):
ALPACA_MAIN_API_KEY=
ALPACA_MAIN_API_SECRET=
ALPACA_MAIN_BASE_URL=https://paper-api.alpaca.markets

# MT5 accounts (same-host terminal only, one terminal instance per account):
MT5_MAIN_LOGIN=
MT5_MAIN_PASSWORD=
MT5_MAIN_SERVER=

# IBKR: no per-account env vars here — connection host/port/client_id are
# passed when constructing IBKRBroker() in app/main.py (one Gateway/TWS
# process per account).

# MT4/MT5 via MetaApi (github.com/metaapi/metaapi-python-sdk), no local
# terminal needed — recommended over the same-host MT5_* vars above unless
# you specifically want to avoid the cloud dependency:
MT4_MT5_METAAPI_TOKEN=
MT4_MT5_METAAPI_MAIN_ID=          # this account's MetaApi account id
MT4_MT5_METAAPI_SOURCE_ACCOUNT_ID=  # MetaApi account id to copy trades FROM (source, not a destination)

# NinjaTrader accounts: the local URL of that account's TradeRouter
# WebhookOrderStrategy.cs instance (github.com/roydufek/traderouter) —
# see app/brokers/ninjatrader.py for setup:
NT8_MAIN_URL=http://127.0.0.1:7091/webhook/

# IBKR (TWS/IB Gateway must already be running and logged in locally —
# see app/brokers/ibkr.py's module docstring): the host/port/client_id
# app/main.py's broker registry connects with. Previously hardcoded to
# 127.0.0.1:7497 (TWS paper) with no way to override at all — set
# IBKR_PORT=4002 for IB Gateway paper, 7496/4001 for TWS/Gateway live.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ccxt crypto exchange (per-account API keys are CCXT_<ACCOUNT_ID>_API_KEY/
# _API_SECRET below, never here) — which exchange this deployment's single
# CCXTBroker instance talks to. Previously hardcoded to "binance" with no
# way to override at all. CCXT_SANDBOX=true points it at that exchange's
# own sandbox/testnet (ccxt's set_sandbox_mode) instead of its real venue —
# raises immediately if the configured exchange has no sandbox ccxt knows
# about, rather than silently trading real funds.
CCXT_EXCHANGE_ID=binance
CCXT_SANDBOX=false
# Set this instead of CCXT_EXCHANGE_ID to run MULTIPLE exchanges at once —
# one broker per exchange, named ccxt_<id> (e.g. accounts.yaml would use
# `broker: ccxt_binance` and `broker: ccxt_kraken` for two different
# accounts). ccxt bundles 100+ real exchange integrations — run
# `python3 -c "import ccxt; print(ccxt.exchanges)"` in the signal-copier
# venv for the full current list (includes binance, kraken, coinbase,
# coinbaseexchange, bybit, okx, kucoin, gemini, bitstamp, and many more).
# Leave empty (the default) to keep the single CCXT_EXCHANGE_ID broker above.
CCXT_EXCHANGES=

# Tradovate (US futures) — official REST API, no official Python SDK
# (app/brokers/tradovate.py talks to it directly). Per-account credentials,
# TRADOVATE_<ACCOUNT_ID>_*. ACCOUNT_SPEC is the real Tradovate account NAME
# (what Tradovate itself calls accountSpec, e.g. "DEMO123456"), looked up
# via /account/list — this service's own account_id is a local identifier
# and is never assumed to match it. ENV is "demo" (default, use a free
# Tradovate demo account first) or "live".
TRADOVATE_MAIN_USERNAME=
TRADOVATE_MAIN_PASSWORD=
TRADOVATE_MAIN_APP_ID=
TRADOVATE_MAIN_APP_VERSION=1.0
TRADOVATE_MAIN_CID=
TRADOVATE_MAIN_SECRET=
TRADOVATE_MAIN_DEVICE_ID=
TRADOVATE_MAIN_ACCOUNT_SPEC=
TRADOVATE_MAIN_ENV=demo

# OANDA (forex) — official v20 REST API, no official Python SDK
# (app/brokers/oanda.py talks to it directly). Per-account credentials,
# OANDA_<ACCOUNT_ID>_*. ACCOUNT_ID here is OANDA's own v20 account id
# (e.g. "101-004-1435156-001", found on your OANDA account page) — not
# this service's own local account_id. ENV is "practice" (default, use a
# free OANDA practice account first) or "live".
OANDA_MAIN_TOKEN=
OANDA_MAIN_ACCOUNT_ID=
OANDA_MAIN_ENV=practice

# TradeStation (equities/options/futures) — official REST API v3, no
# official Python SDK (app/brokers/tradestation.py talks to it directly).
# Per-account credentials, TRADESTATION_<ACCOUNT_ID>_*. REFRESH_TOKEN
# requires a one-time interactive OAuth2 authorization-code consent via
# TradeStation's own developer portal (developer.tradestation.com) to
# obtain FIRST -- this codebase cannot automate that first step for you.
# TS_ACCOUNT_ID is TradeStation's own account id string, not this
# service's local account_id. ENV is "sim" (default, use TradeStation's
# free simulated account first) or "live".
TRADESTATION_MAIN_CLIENT_ID=
TRADESTATION_MAIN_CLIENT_SECRET=
TRADESTATION_MAIN_REFRESH_TOKEN=
TRADESTATION_MAIN_TS_ACCOUNT_ID=
TRADESTATION_MAIN_ENV=sim

# Tastytrade (equities/options) — real REST API, both an official and a
# more actively-maintained unofficial Python SDK exist, but this app
# talks to the API directly (app/brokers/tastytrade.py). Per-account
# credentials, TASTYTRADE_<ACCOUNT_ID>_*. REFRESH_TOKEN requires a
# one-time interactive OAuth2 consent step via Tastytrade's own developer
# portal (developer.tastytrade.com) to obtain FIRST -- this codebase
# cannot automate that first step for you. TT_ACCOUNT_NUMBER is
# Tastytrade's own account number string, not this service's local
# account_id. ENV is "cert" (default, Tastytrade's own sandbox) or "live".
# See app/brokers/tastytrade.py's own module docstring for a disclosed,
# NOT independently verified limitation: this adapter always tags an
# order "to Open" and has not been confirmed against a real sandbox
# account for closing an existing position.
TASTYTRADE_MAIN_SECRET=
TASTYTRADE_MAIN_REFRESH_TOKEN=
TASTYTRADE_MAIN_TT_ACCOUNT_NUMBER=
TASTYTRADE_MAIN_ENV=cert

# Rithmic (github.com/rundef/async_rithmic) — licensed credentials from
# your broker; shared login used for both the source and every Rithmic
# destination account:
RITHMIC_USER=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM_NAME=
RITHMIC_GATEWAY_URL=              # e.g. rituz00100.rithmic.com:443 (test gateway)
RITHMIC_SOURCE_ACCOUNT_ID=        # optional: only copy fills from this Rithmic account
# Per Rithmic destination account (account_id as used in accounts.yaml):
RITHMIC_MAIN_RITHMIC_ACCOUNT_ID=  # Rithmic's own account id, from client.list_accounts()
RITHMIC_MAIN_EXCHANGE=            # e.g. CME

# --- Pull-based sources: each only starts if ALL of its vars below are set ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

TWITTER_BEARER_TOKEN=
TWITTER_RULES=                 # comma-separated, e.g. "from:SomeTrader,from:AnotherTrader"

# --- SMS source (push-based via /sms/twilio route) ---
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=            # the exact public URL Twilio POSTs to, e.g. https://yourhost/sms/twilio
TWILIO_ALLOWED_FROM_NUMBERS=   # comma-separated E.164 numbers authorized to send trading SMS, e.g. "+15551234567" -- required, a valid signature alone does not authorize the sender

# --- WhatsApp source (push-based via /whatsapp/webhook route) ---
# Official Meta WhatsApp Business Cloud API -- see app/sources/whatsapp.py's
# docstring for full setup. Deliberately NOT an unofficial WhatsApp Web
# automation library (whatsapp-web.js, Baileys, OpenWA, etc.): those violate
# WhatsApp's Terms of Service and risk the number being banned.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=          # your own chosen value, used once for Meta's GET handshake when the webhook is first configured
WHATSAPP_ALLOWED_FROM_NUMBERS=  # comma-separated numbers with NO leading '+' (WhatsApp's own wa_id format), e.g. "15551234567" -- required, a valid signature alone does not authorize the sender

# --- NinjaTrader source (push-based via /ninjatrader/webhook route) ---
# A NinjaScript AddOn/Indicator (ninjascript/SignalCopierAutoJournal.cs --
# see app/sources/ninjatrader.py's docstring for what's verified vs. still
# unverified about that C# side) POSTs fill events here with this value
# in an X-NinjaTrader-Secret header. NinjaScript has no built-in request
# signing, so this is a plain shared secret, not an HMAC signature.
NINJATRADER_WEBHOOK_SECRET=

FORCE_SECURE_COOKIES=      # set true if behind a TLS-terminating reverse proxy (nginx/Caddy) -- see SEC-05
