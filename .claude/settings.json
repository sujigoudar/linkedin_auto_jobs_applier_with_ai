{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/signal_copier_ruff_check.sh",
            "timeout": 30,
            "statusMessage": "ruff check (signal-copier)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/signal_copier_precommit_gate.sh",
            "timeout": 120,
            "statusMessage": "signal-copier pre-commit gate (lint + typecheck)"
          }
        ]
      }
    ]
  }
}
